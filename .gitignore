__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Project-local uv cache (downloaded standalone Python + package cache).
# Created by run.sh / run.ps1; safe to delete to force a clean reinstall.
.uv/

# Downloaded model files — fetched by scripts/download_model.py
models/

# Editor/OS noise
.vscode/
.idea/
.DS_Store

# nova/ used to be ignored (it's normally cloned by bootstrap_pi.sh from
# yubraj525/Nova-HomeAutomation). On the `complete-humanoid` branch we
# track it directly so this branch is a self-contained snapshot of the
# working pipeline. Nova's own .gitignore still excludes nova/.env (the
# Groq API key) and nova/.venv, so secrets stay out.

# Don't push the local browser cookies (yt-dlp tracking IDs) or the
# pre-patch tts_engine backup the bootstrap leaves behind.
nova/cookies.txt
nova/**/*.bak

# Face recognition: the Python package IS committed (we own the code),
# but downloaded models and registered face data stay local.
face-recognition/models/
face-recognition/face_data/
